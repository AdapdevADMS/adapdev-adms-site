---
/**
 * /adms/features
 *
 * Full feature breakdown grouped by concern: Organise, Capture, Control,
 * Integrate, Protect. Sourced from the earlier adapdev-adms-site
 * features page; styled with the Lapse theme tokens.
 */
import Base from '../layouts/Base.astro';
import Button from '../components/ui/Button.astro';

const groups = [
  {
    title: 'Organise',
    items: [
      {
        title: 'Client-centric',
        body: 'Every document lives under a client. For law firms, clients contain matters; for tradies, clients contain jobs.',
      },
      {
        title: 'Fast full-text search',
        body: 'Find any document by content, filename, client, matter, or tag. Results appear as you type.',
      },
      {
        title: 'Tags and metadata',
        body: 'Custom metadata per document type, with required-field enforcement so filing is consistent across your team.',
      },
    ],
  },
  {
    title: 'Capture',
    items: [
      {
        title: 'Save from Word',
        body: 'File → Save straight into ADMS, prompting for the client / matter. No separate upload step.',
      },
      {
        title: 'Save from Outlook',
        body: 'Save an email, or its attachments, against a client or matter. Thread conversations stay linked.',
      },
      {
        title: 'Drag-and-drop import',
        body: 'Drop any folder onto the desktop client; ADMS imports and (optionally) OCRs the contents.',
      },
    ],
  },
  {
    title: 'Control',
    items: [
      {
        title: 'Per-user permissions',
        body: 'Fine-grained permissions per client, matter and document type. Partners see trust files; juniors do not.',
      },
      {
        title: 'Full audit log',
        body: 'Every read, write and delete recorded with user, timestamp and IP. Required for law-firm compliance.',
      },
      {
        title: 'Checkout / check-in',
        body: 'Lock a document for exclusive editing. Automatic version history on every check-in.',
      },
    ],
  },
  {
    title: 'Integrate',
    items: [
      {
        title: 'REST API',
        body: 'A documented REST API lets you script bulk imports, nightly reports, or integrate with your own tooling.',
      },
      {
        title: 'Office add-ins',
        body: 'Native add-ins for Word, Outlook, Excel and PowerPoint, installed by the desktop client installer.',
      },
      {
        title: 'OAuth to Xero / MYOB / Salesforce',
        body: 'Pull client lists from your accounting or CRM system; push invoices back when ready. OAuth tokens stored encrypted.',
      },
    ],
  },
  {
    title: 'Protect',
    items: [
      {
        title: 'On-premises deployment',
        body: 'SQLite for sole traders; SQL Server for small business and law firms. You pick the deployment that fits.',
      },
      {
        title: 'DPAPI secret storage',
        body: 'Secrets bound to the Windows service account on the ADMS server, via the ISecretProvider abstraction.',
      },
      {
        title: 'Automated backup',
        body: 'Scheduled backups to the destination of your choice (NAS, external drive, S3-compatible). Restore tested every quarter.',
      },
    ],
  },
];
---
<Base
  title="Features — ADMS"
  description="Every ADMS feature at a glance: client / matter organisation, Office integration, API + desktop, audit, backup, security."
>
  <section class="top">
    <p class="t-eyebrow">Features</p>
    <h1 class="t-h1 balance">Everything ADMS does, grouped by concern.</h1>
    <p class="t-body-m balance lede">
      ADMS pairs a REST API backend with a native Windows desktop client and Office add-ins. The groups below cover the whole product; nothing is held back for a higher tier.
    </p>
    <div class="actions">
      <Button href="/adms/downloads">Download ADMS</Button>
      <Button href="/adms/pricing" variant="ghost">See pricing</Button>
    </div>
  </section>

  {groups.map((group, i) => (
    <section class={`group ${i % 2 === 0 ? 'group--plain' : 'group--tinted'}`}>
      <h2 class="t-h2 group__title">{group.title}</h2>
      <div class="grid">
        {group.items.map((item) => (
          <article class="card">
            <h3 class="t-h4 card__title">{item.title}</h3>
            <p class="t-body-m card__body">{item.body}</p>
          </article>
        ))}
      </div>
    </section>
  ))}
</Base>

<style>
  .top {
    width: 100%; max-width: var(--canvas); margin: 0 auto;
    padding: 100px 20px 60px;
    display: flex; flex-direction: column; gap: 24px;
  }
  .top h1 { max-width: 800px; }
  .lede { max-width: 720px; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; padding-top: 8px; }

  .group {
    width: 100%; max-width: var(--canvas); margin: 0 auto;
    padding: 60px 20px;
    display: flex; flex-direction: column; gap: 32px;
  }
  .group--tinted {
    background: var(--surface);
    border-radius: var(--radius);
    max-width: calc(var(--canvas) - 40px);
    margin: 20px auto;
  }
  .group__title { max-width: 600px; }

  .grid {
    display: grid; gap: 20px;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  }
  .card {
    display: flex; flex-direction: column; gap: 12px;
    padding: 24px;
    background: var(--surface);
    border: 1px solid var(--grey-20);
    border-radius: 12px;
    transition: border-color 0.3s var(--ease-soft), transform 0.3s var(--ease-soft);
  }
  .card:hover { border-color: var(--accent-bright); transform: translateY(-2px); }
  .card__title { color: var(--white); }
  .card__body { color: var(--grey); }

  @media (max-width: 809.98px) {
    .top { padding: 64px 20px 40px; }
    .group { padding: 40px 20px; gap: 24px; }
  }
</style>
