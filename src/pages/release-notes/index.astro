---
/**
 * /adms/release-notes
 *
 * Lists every release in the `releaseNotes` content collection, newest first.
 * Each entry links to its detail page; the sticky-badge style reflects the
 * release channel.
 */
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import page from '../../content/pages/blog.json';

const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');

const releases = (await getCollection('releaseNotes', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);

const formatDate = (d: Date): string =>
  d.toLocaleDateString('en-AU', { year: 'numeric', month: 'long', day: 'numeric' });
---
<Base title={page.meta.title} description={page.meta.description}>
  <section class="top">
    <p class="t-eyebrow">{page.hero.eyebrow}</p>
    <h1 class="t-h1 balance">{page.hero.heading}</h1>
    <p class="t-body-m balance lede">
      {page.hero.blurb} <a href={`${BASE}/release-notes/rss.xml`}>Subscribe via RSS</a>.
    </p>
  </section>

  <section class="list">
    {releases.length === 0 ? (
      <p class="t-body-m muted">{page.empty}</p>
    ) : (
      <ul class="releases">
        {releases.map((r) => (
          <li class="release">
            <a href={`${BASE}/release-notes/${r.id}`} class="release__link">
              <div class="release__header">
                <h2 class="t-h4 release__title">{r.data.title}</h2>
                <span class={`chip chip--${r.data.channel}`}>{r.data.channel}</span>
              </div>
              <p class="release__meta">
                <span class="release__version">v{r.data.version}</span>
                <span class="sep">{page.metaSeparator}</span>
                <time datetime={r.data.pubDate.toISOString()}>{formatDate(r.data.pubDate)}</time>
              </p>
              <p class="release__desc t-body-m">{r.data.description}</p>
              {r.data.highlights.length > 0 && (
                <ul class="release__highlights">
                  {r.data.highlights.slice(0, 3).map((h) => <li>{h}</li>)}
                </ul>
              )}
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</Base>

<style>
  .top {
    width: 100%; max-width: var(--canvas); margin: 0 auto;
    padding: 100px 20px 40px;
    display: flex; flex-direction: column; gap: 20px;
  }
  .top h1 { max-width: 760px; }
  .lede { max-width: 720px; color: var(--grey); }
  .lede a { color: var(--accent-sky); text-decoration: underline; text-underline-offset: 2px; }

  .list {
    width: 100%; max-width: var(--canvas); margin: 0 auto;
    padding: 20px 20px 100px;
  }
  .muted { color: var(--dark-grey); }

  .releases { list-style: none; padding: 0; margin: 0; display: grid; gap: 16px; }
  .release {
    border: 1px solid var(--grey-20);
    border-radius: var(--radius);
    background: var(--surface);
    transition: border-color 0.3s var(--ease-soft), transform 0.3s var(--ease-soft);
  }
  .release:hover { border-color: var(--accent-bright); transform: translateY(-2px); }
  .release__link { display: block; padding: 24px 28px; color: inherit; }
  .release__header { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  .release__title { margin: 0; }
  .release__meta { display: flex; gap: 8px; align-items: center; color: var(--dark-grey); font-size: 14px; margin: 6px 0 10px; }
  .release__version { font-family: var(--font-mono); color: var(--white); }
  .sep { color: var(--grey-20); }
  .release__desc { color: var(--grey); margin: 0; }
  .release__highlights { margin: 12px 0 0; padding-left: 1.1em; color: var(--grey); font-size: 14px; display: grid; gap: 4px; list-style: disc; }

  .chip {
    display: inline-block; padding: 2px 10px; border-radius: 999px;
    font-size: 11px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase;
  }
  .chip--stable  { background: rgba(22, 101, 52, 0.25);  color: #86efac; }
  .chip--preview { background: var(--accent-tint);       color: var(--accent-sky); }
  .chip--beta    { background: rgba(180, 83, 9, 0.25);   color: #fcd34d; }

  @media (max-width: 809.98px) {
    .top { padding: 64px 20px 32px; }
    .list { padding: 20px 20px 64px; }
  }
</style>
