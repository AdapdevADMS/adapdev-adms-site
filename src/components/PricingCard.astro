---
/**
 * PricingCard.astro - one pricing tier.
 *
 * The `featured` prop marks the recommended tier with a stronger border and
 * a small accent chip. Prices and tier contents are illustrative placeholders;
 * replace with the real numbers before launch.
 */

export interface Props {
  tier: string;
  audience: string;
  price: string;
  cadence: string;
  features: string[];
  ctaLabel: string;
  ctaHref: string;
  featured?: boolean;
}

const {
  tier,
  audience,
  price,
  cadence,
  features,
  ctaLabel,
  ctaHref,
  featured = false,
} = Astro.props;
---

<article class:list={['pricing', { 'pricing--featured': featured }]}>
  {featured && <span class="pricing__chip">Most popular</span>}
  <h3 class="pricing__tier">{tier}</h3>
  <p class="pricing__audience muted">{audience}</p>
  <p class="pricing__price">
    <span class="pricing__amount">{price}</span>
    <span class="pricing__cadence muted">{cadence}</span>
  </p>
  <ul class="pricing__features">
    {features.map((f) => <li>{f}</li>)}
  </ul>
  <a href={ctaHref} class:list={['btn', { 'btn--ghost': !featured }]}>{ctaLabel}</a>
</article>

<style>
  .pricing {
    position: relative;
    padding: var(--space-6);
    background: var(--brand-white);
    border: 1px solid var(--brand-rule);
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    height: 100%;
  }

  .pricing--featured {
    border-color: var(--brand-bright);
    box-shadow: var(--shadow-md);
  }

  .pricing__chip {
    position: absolute;
    top: -12px;
    left: var(--space-5);
    background: var(--brand-navy-deep);
    color: var(--brand-white);
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .pricing__tier {
    margin: 0;
    font-size: var(--fs-xl);
    color: var(--brand-navy-deep);
  }

  .pricing__audience {
    margin: 0;
  }

  .pricing__price {
    margin: var(--space-3) 0;
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
  }

  .pricing__amount {
    font-size: var(--fs-3xl);
    font-weight: 700;
    color: var(--brand-navy-deep);
  }

  .pricing__features {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-5);
    display: grid;
    gap: var(--space-2);
  }

  .pricing__features li {
    padding-left: 1.5em;
    position: relative;
  }

  .pricing__features li::before {
    content: '\2713';
    color: var(--brand-bright);
    position: absolute;
    left: 0;
    font-weight: 700;
  }

  .pricing a {
    margin-top: auto;
    align-self: flex-start;
  }
</style>
